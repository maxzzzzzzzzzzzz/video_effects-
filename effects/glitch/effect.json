{
  "id": "glitch",
  "name": "Glitch",
  "description": "Digital glitch with block displacement, vertical roll and RGB split.",
  "author": "maxzzzzzzzzzzzz",
  "license": "MIT",
  "version": "1.0.0",
  "category": "glitch",
  "tags": ["glitch", "digital", "distortion", "datamosh"],
  "shader": "glitch.glsl",
  "preview": "preview.webp",
  "parameters": [
    {
      "id": "uIntensity",
      "name": "Intensity",
      "description": "Overall strength of the glitch.",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5
    },
    {
      "id": "uBlockSize",
      "name": "Block Size",
      "description": "Size of the displaced blocks (larger value = bigger blocks).",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5
    },
    {
      "id": "uSpeed",
      "name": "Speed",
      "description": "How fast the glitch pattern changes.",
      "type": "float",
      "min": 0.1,
      "max": 3.0,
      "default": 1.0
    }
  ],
  "compatibility": {
    "minRegistryVersion": 1,
    "minAppVersion": "1.0.0",
    "platforms": ["android"],
    "shaderLanguage": "glsl-es-100",
    "requiredExtensions": ["GL_OES_EGL_image_external"]
  }
}
