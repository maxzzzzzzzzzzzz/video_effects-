{
  "id": "film_grain",
  "name": "Film Grain",
  "description": "Animated film grain with a warm filmic tone and vignette.",
  "author": "maxzzzzzzzzzzzz",
  "license": "Edactor",
  "version": "1.0.0",
  "category": "retro",
  "tags": ["film", "grain", "vintage", "vignette", "analog"],
  "shader": "film_grain.glsl",
  "preview": "preview.webp",
  "parameters": [
    {
      "id": "uIntensity",
      "name": "Intensity",
      "description": "Overall strength of the grain and tone.",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5
    },
    {
      "id": "uGrainSize",
      "name": "Grain Size",
      "description": "Grain particle size in pixels.",
      "type": "float",
      "min": 1.0,
      "max": 8.0,
      "default": 2.0
    },
    {
      "id": "uVignette",
      "name": "Vignette",
      "description": "Darkening toward the corners.",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "default": 0.8
    }
  ],
  "compatibility": {
    "minRegistryVersion": 1,
    "minAppVersion": "1.0.0",
    "platforms": ["android"],
    "shaderLanguage": "glsl-es-100",
    "requiredExtensions": ["GL_OES_EGL_image_external"]
  }
}
